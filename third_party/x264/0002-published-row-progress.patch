---
 common/common.h   |  4 ++++
 encoder/analyse.c | 20 +++++++++++++++++++-
 encoder/encoder.c |  3 +++
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/common/common.h b/common/common.h
index a22e224..4b02e29 100644
--- a/common/common.h
+++ b/common/common.h
@@ -481,6 +481,10 @@ struct x264_t
          * same mv_min/max but includes levels' i_mv_range. */
         int     mv_min_spel[2];
         int     mv_max_spel[2];
+#if X264_ATOMIC_FRAME_PROGRESS
+        /* Lower bound acquired from every reference at the row wait. */
+        int     i_thread_progress_min;
+#endif
         int     mv_miny_spel_row[3];
         int     mv_maxy_spel_row[3];
         /* Fullpel MV range for motion search */
diff --git a/encoder/analyse.c b/encoder/analyse.c
index adb63e1..71ac7ac 100644
--- a/encoder/analyse.c
+++ b/encoder/analyse.c
@@ -356,12 +356,22 @@ static void mb_analyse_init( x264_t *h, x264_mb_analysis_t *a, int qp )
             {
                 int pix_y = (h->mb.i_mb_y | PARAM_INTERLACED) * 16;
                 int thresh = pix_y + h->param.analyse.i_mv_range_thread;
+#if X264_ATOMIC_FRAME_PROGRESS
+                int published_min = INT_MAX;
+#endif
                 for( int i = (h->sh.i_type == SLICE_TYPE_B); i >= 0; i-- )
                     for( int j = 0; j < h->i_ref[i]; j++ )
                     {
                         int completed = x264_frame_cond_wait( h->fref[i][j]->orig, thresh );
                         thread_mvy_range = X264_MIN( thread_mvy_range, completed - pix_y );
+#if X264_ATOMIC_FRAME_PROGRESS
+                        published_min = X264_MIN( published_min, completed );
+#endif
                     }
+#if X264_ATOMIC_FRAME_PROGRESS
+                if( !PARAM_INTERLACED && h->param.b_deterministic )
+                    h->mb.i_thread_progress_min = published_min;
+#endif
 
                 if( h->param.b_deterministic )
                     thread_mvy_range = h->param.analyse.i_mv_range_thread;
@@ -3869,8 +3879,16 @@ static void analyse_update_cache( x264_t *h, x264_mb_analysis_t *a  )
             int ref = h->mb.cache.ref[l][x264_scan8[0]];
             if( ref < 0 )
                 continue;
+            int required = (h->mb.cache.mv[l][x264_scan8[15]][1] >> (2 - MB_INTERLACED)) + h->mb.i_mb_y*16;
+#if X264_ATOMIC_FRAME_PROGRESS
+            /* Progress cannot retreat during a reference's active lifetime.
+             * A published lower bound proves this MV safe; otherwise retain
+             * the original live-progress check and its recovery path. */
+            if( (ref >> MB_INTERLACED) < h->i_ref[l] && required <= h->mb.i_thread_progress_min )
+                continue;
+#endif
             completed = x264_frame_cond_wait( h->fref[l][ ref >> MB_INTERLACED ]->orig, -1 );
-            if( (h->mb.cache.mv[l][x264_scan8[15]][1] >> (2 - MB_INTERLACED)) + h->mb.i_mb_y*16 > completed )
+            if( required > completed )
             {
                 x264_log( h, X264_LOG_WARNING, "internal error (MV out of thread range)\n");
                 x264_log( h, X264_LOG_DEBUG, "mb type: %d \n", h->mb.i_type);
diff --git a/encoder/encoder.c b/encoder/encoder.c
index 8bc30c6..306de80 100644
--- a/encoder/encoder.c
+++ b/encoder/encoder.c
@@ -3481,6 +3481,9 @@ int     x264_encoder_encode( x264_t *h,
     if( reference_update( h ) )
         return -1;
     x264_frame_progress_store( h->fdec, -1 );
+#if X264_ATOMIC_FRAME_PROGRESS
+    h->mb.i_thread_progress_min = -1;
+#endif
 
     if( !IS_X264_TYPE_I( h->fenc->i_type ) )
     {
